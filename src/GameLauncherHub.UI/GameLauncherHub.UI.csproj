<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GameLauncherHub.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <!-- Metadados de Produto e Versão -->
    <AssemblyTitle>GameLauncher Hub</AssemblyTitle>
    <Product>GameLauncher Hub</Product>
    <Description>Centralizador profissional de instalação e execução de plataformas de jogos para Windows</Description>
    <Company>Ademir Junior</Company>
    <Authors>Ademir Junior</Authors>
    <Version>0.11.11-b1</Version>
    <InformationalVersion>0.11.11b1</InformationalVersion>
    <FileVersion>0.11.11.1</FileVersion>
    <AssemblyVersion>0.11.11.1</AssemblyVersion>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    
    <!-- Otimizações Críticas de Consumo de Memória (Workstation GC & DATAS) -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\icon.ico" />
    <Resource Include="Resources\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameLauncherHub.Domain\GameLauncherHub.Domain.csproj" />
    <ProjectReference Include="..\GameLauncherHub.Application\GameLauncherHub.Application.csproj" />
    <ProjectReference Include="..\GameLauncherHub.Infrastructure\GameLauncherHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.2" />
  </ItemGroup>

</Project>

