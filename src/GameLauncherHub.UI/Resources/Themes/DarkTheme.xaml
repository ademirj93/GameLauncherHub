<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores Base do Tema Escuro Grafite (Inspirado no ArtCraftLauncher) -->
    <Color x:Key="WindowBackgroundColor">#0E1015</Color>
    <Color x:Key="HeaderBackgroundColor">#141720</Color>
    <Color x:Key="SurfaceBackgroundColor">#1A1D27</Color>
    <Color x:Key="SurfaceHoverColor">#222634</Color>
    <Color x:Key="SurfaceBorderColor">#2C3040</Color>
    <Color x:Key="SurfaceBorderHoverColor">#434A62</Color>

    <!-- Cores de Texto -->
    <Color x:Key="TextPrimaryColor">#F3F4F6</Color>
    <Color x:Key="TextSecondaryColor">#9CA3AF</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <!-- Cores de Acento e Status Semântico -->
    <Color x:Key="AccentIndigoColor">#6366F1</Color>
    <Color x:Key="AccentIndigoHoverColor">#4F46E5</Color>
    <Color x:Key="SuccessEmeraldColor">#10B981</Color>
    <Color x:Key="SuccessEmeraldHoverColor">#059669</Color>
    <Color x:Key="RunningSkyColor">#3B82F6</Color>
    <Color x:Key="WarningAmberColor">#F59E0B</Color>
    <Color x:Key="DangerRoseColor">#EF4444</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorderColor}" />
    <SolidColorBrush x:Key="SurfaceBorderHoverBrush" Color="{StaticResource SurfaceBorderHoverColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentIndigoBrush" Color="{StaticResource AccentIndigoColor}" />
    <SolidColorBrush x:Key="AccentIndigoHoverBrush" Color="{StaticResource AccentIndigoHoverColor}" />
    <SolidColorBrush x:Key="SuccessEmeraldBrush" Color="{StaticResource SuccessEmeraldColor}" />
    <SolidColorBrush x:Key="SuccessEmeraldHoverBrush" Color="{StaticResource SuccessEmeraldHoverColor}" />
    <SolidColorBrush x:Key="RunningSkyBrush" Color="{StaticResource RunningSkyColor}" />
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmberColor}" />
    <SolidColorBrush x:Key="DangerRoseBrush" Color="{StaticResource DangerRoseColor}" />

    <!-- Tipografia Padrão Moderna -->
    <FontFamily x:Key="MainFontFamily">Segoe UI, Segoe UI Variable Display, sans-serif</FontFamily>

</ResourceDictionary>

