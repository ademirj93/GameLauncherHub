<Window x:Class="GameLauncherHub.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:GameLauncherHub.UI.Views.Components"
        xmlns:viewmodels="clr-namespace:GameLauncherHub.UI.ViewModels"
        xmlns:converters="clr-namespace:GameLauncherHub.UI.Converters"
        mc:Ignorable="d"
        Title="GameLauncher Hub"
        Height="780" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource MainFontFamily}"
        Icon="Resources/icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />  <!-- 0. Barra de Título Customizada -->
            <RowDefinition Height="Auto" /><!-- 1. Banner de Atualização Disponível -->
            <RowDefinition Height="Auto" /><!-- 2. Barra de Filtros e Pesquisa -->
            <RowDefinition Height="*" />   <!-- 3. Grade ou Lista de Launchers -->
            <RowDefinition Height="32" />  <!-- 4. Barra de Status / Rodapé -->
        </Grid.RowDefinitions>

        <!-- 1. BARRA DE TÍTULO CUSTOMIZADA -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identidade / Ícone do Hub -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Border Width="26"
                            Height="26"
                            CornerRadius="6"
                            Background="{StaticResource AccentIndigoBrush}"
                            VerticalAlignment="Center">
                        <Path Width="14"
                              Height="14"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="#FFFFFF"
                              Data="{StaticResource IconPlay}" />
                    </Border>
                    <TextBlock Text="GAMELAUNCHER"
                               FontWeight="Black"
                               FontSize="14"
                               Foreground="#FFFFFF"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="HUB"
                               FontWeight="Light"
                               FontSize="14"
                               Foreground="{StaticResource AccentIndigoBrush}"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center" />

                    <!-- Badge de Métricas Rápidas -->
                    <Border Background="#1C202C"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,2"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} Plataformas'}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text=" • "
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding EmulatorsCount, StringFormat='{}{0} Emuladores'}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentIndigoBrush}" />
                            <TextBlock Text=" • "
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding InstalledCount, StringFormat='{}{0} Instaladas'}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessEmeraldBrush}" />
                            <TextBlock Text=" • "
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding FavoriteCount, StringFormat='★ {0}'}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#F59E0B" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Botões de Ação do Topo e Controle de Janela -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                    <!-- Botão de Atualizar Todos / Imagens -->
                    <Button Style="{StaticResource GhostIconButton}"
                            Width="30"
                            Height="30"
                            Margin="0,0,8,0"
                            ToolTip="Recarregar catálogo e verificar instalações"
                            Command="{Binding LoadPlatformsCommand}">
                        <Path Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Data="{StaticResource IconRefresh}" />
                    </Button>

                    <!-- Botão de Histórico de Operações -->
                    <Button Style="{StaticResource GhostIconButton}"
                            Width="30"
                            Height="30"
                            Margin="0,0,8,0"
                            ToolTip="Auditoria e Histórico de Operações"
                            Command="{Binding OpenHistoryCommand}">
                        <Path Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Data="{StaticResource IconHistory}" />
                    </Button>

                    <!-- Botão de Configurações -->
                    <Button Style="{StaticResource GhostIconButton}"
                            Width="30"
                            Height="30"
                            Margin="0,0,8,0"
                            ToolTip="Configurações e Preferências"
                            Command="{Binding OpenSettingsCommand}">
                        <Path Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Data="{StaticResource IconSettings}" />
                    </Button>

                    <!-- Botão de Verificar Atualizações do Hub -->
                    <Button Style="{StaticResource GhostIconButton}"
                            Width="30"
                            Height="30"
                            Margin="0,0,8,0"
                            ToolTip="Verificar atualizações do GameLauncher Hub no GitHub"
                            Command="{Binding CheckForUpdatesCommand}">
                        <Path Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Data="{StaticResource IconDownload}" />
                    </Button>

                    <!-- Botão Sobre o Aplicativo -->
                    <Button Style="{StaticResource GhostIconButton}"
                            Width="30"
                            Height="30"
                            Margin="0,0,10,0"
                            ToolTip="Sobre o GameLauncher Hub"
                            Command="{Binding OpenAboutCommand}">
                        <Path Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Data="{StaticResource IconInfo}" />
                    </Button>

                    <!-- Pílula de Atualização Disponível (exibida apenas quando detectada nova versão) -->
                    <Button Style="{StaticResource ModernActionButton}"
                            Background="#10B981"
                            Height="26"
                            Padding="8,0"
                            Margin="0,0,12,0"
                            ToolTip="Nova versão disponível no GitHub (Clique para atualizar)"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding OpenUpdateDialogCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="10" Height="10" Stretch="Uniform" Fill="#FFFFFF" Data="{StaticResource IconDownload}" Margin="0,0,6,0" />
                            <TextBlock Text="Atualização" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Button>

                    <!-- Botões Padrão da Janela do Windows -->
                    <Button Style="{StaticResource WindowControlButton}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimizar">
                        <Path Width="10"
                              Height="2"
                              Stretch="Uniform"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Data="{StaticResource IconMinimize}" />
                    </Button>
                    <Button Style="{StaticResource WindowControlButton}"
                            Click="MaximizeButton_Click"
                            ToolTip="Maximizar / Restaurar">
                        <Path Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Data="{StaticResource IconMaximize}" />
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}"
                            Click="CloseButton_Click"
                            ToolTip="Fechar">
                        <Path Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Data="{StaticResource IconClose}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. BANNER DE ATUALIZAÇÃO DISPONÍVEL (SLIDE-IN DISPENSÁVEL) -->
        <Border Grid.Row="1"
                Background="#161F2E"
                BorderBrush="{StaticResource SuccessEmeraldBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10"
                Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource SuccessEmeraldBrush}" Margin="0,0,10,0">
                        <Path Width="11" Height="11" Stretch="Uniform" Fill="#FFFFFF" Data="{StaticResource IconDownload}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Nova versão disponível!" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Background="#122A1E" BorderBrush="{StaticResource SuccessEmeraldBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding AvailableUpdate.TagName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessEmeraldBrush}" />
                    </Border>
                    <TextBlock Text="Uma versão atualizada do GameLauncher Hub está pronta para instalação." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Atualizar Agora"
                            Style="{StaticResource ModernActionButton}"
                            Background="{StaticResource SuccessEmeraldBrush}"
                            Height="28" Padding="14,0"
                            FontWeight="Bold"
                            Command="{Binding OpenUpdateDialogCommand}"
                            Margin="0,0,8,0" />

                    <Button Style="{StaticResource GhostIconButton}"
                            Width="28" Height="28"
                            ToolTip="Dispensar aviso de atualização"
                            Command="{Binding DismissUpdateBannerCommand}">
                        <Path Width="10" Height="10" Stretch="Uniform" Fill="{StaticResource TextMutedBrush}" Data="{StaticResource IconClose}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. BARRA DE FILTROS, PESQUISA E ALTERNÂNCIA DE MODO -->
        <Border Grid.Row="2"
                Background="#10121A"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Campo de Pesquisa em Tempo Real -->
                <TextBox Grid.Column="0"
                         Style="{StaticResource ModernSearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Pílulas de Filtro + Seletor de Modo de Visualização (Cards vs Compacto) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <RadioButton Content="Todos"
                                 Style="{StaticResource FilterPillButton}"
                                 IsChecked="True"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="Todos" />

                    <RadioButton Content="🎮 Emuladores"
                                 Style="{StaticResource FilterPillButton}"
                                 Margin="6,0,0,0"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="Emuladores" />

                    <RadioButton Content="🕹 Lojas / Launchers"
                                 Style="{StaticResource FilterPillButton}"
                                 Margin="6,0,0,0"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="Launchers" />

                    <RadioButton Content="★ Favoritos"
                                 Style="{StaticResource FilterPillButton}"
                                 Margin="6,0,0,0"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="Favoritos" />

                    <RadioButton Content="Instalados"
                                 Style="{StaticResource FilterPillButton}"
                                 Margin="6,0,0,0"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="Instalados" />

                    <RadioButton Content="Disponíveis"
                                 Style="{StaticResource FilterPillButton}"
                                 Margin="6,0,0,0"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="Disponíveis" />

                    <!-- Separador Vertical -->
                    <Border Width="1"
                            Height="24"
                            Background="{StaticResource SurfaceBorderBrush}"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center" />

                    <!-- Botão de Adicionar Emulador Personalizado -->
                    <Button Style="{StaticResource ModernActionButton}"
                            Background="{StaticResource AccentIndigoBrush}"
                            Height="30"
                            Padding="10,0"
                            Margin="0,0,10,0"
                            ToolTip="Cadastrar novo emulador instalado ou portátil no Hub"
                            Command="{Binding OpenAddEmulatorCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="10" Height="10" Stretch="Uniform" Fill="#FFFFFF" Data="{StaticResource IconPlus}" Margin="0,0,5,0" />
                            <TextBlock Text="+ Emulador" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Button>

                    <!-- Separador Vertical -->
                    <Border Width="1"
                            Height="24"
                            Background="{StaticResource SurfaceBorderBrush}"
                            Margin="14,0,14,0"
                            VerticalAlignment="Center" />

                    <!-- Seletor de Visualização: Modo Cards -->
                    <Button Style="{StaticResource ViewToggleButton}"
                            ToolTip="Visualização em Cards"
                            Command="{Binding SetViewModeCommand}"
                            CommandParameter="Cards">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Data="{StaticResource IconViewCards}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewMode}" Value="Cards">
                                            <Setter Property="Fill" Value="{StaticResource AccentIndigoBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <!-- Seletor de Visualização: Modo Compacto -->
                    <Button Style="{StaticResource ViewToggleButton}"
                            Margin="4,0,0,0"
                            ToolTip="Visualização Compacta"
                            Command="{Binding SetViewModeCommand}"
                            CommandParameter="Compact">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Data="{StaticResource IconViewCompact}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewMode}" Value="Compact">
                                            <Setter Property="Fill" Value="{StaticResource AccentIndigoBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. ÁREA PRINCIPAL: CARDS OU LINHAS COMPACTAS -->
        <Grid Grid.Row="3">
            <!-- 3.A. Visualização em Cards (WrapPanel) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,18,20,80">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewMode}" Value="Cards">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding FilteredCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:LauncherCardView Width="360" Height="250" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3.B. Visualização Compacta (Horizontal Rows) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,14,24,80">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewMode}" Value="Compact">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding FilteredCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:LauncherCompactView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- BARRA DE AÇÕES FLUTUANTE DE INSTALAÇÃO EM LOTE -->
            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"
                    Padding="18,12"
                    Background="#161822"
                    BorderBrush="{StaticResource AccentIndigoBrush}"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      Opacity="0.75"
                                      ShadowDepth="6"
                                      Direction="270"
                                      Color="#000000" />
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Mensagem com contador e progresso -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Border Width="30"
                                Height="30"
                                CornerRadius="8"
                                Background="#1F2433"
                                VerticalAlignment="Center">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="{StaticResource SuccessEmeraldBrush}"
                                  Data="{StaticResource IconCheck}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedCount}"
                                           FontWeight="Black"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text=" plataforma(s) selecionada(s) para instalação"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="4,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding BatchProgressText, TargetNullValue='Pronto para download oficial seguro'}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Botões de Ação do Lote -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Botão Instalar Selecionadas -->
                        <Button Style="{StaticResource ModernActionButton}"
                                Background="{StaticResource SuccessEmeraldBrush}"
                                Height="34"
                                Padding="16,0"
                                Margin="0,0,8,0"
                                Command="{Binding InstallSelectedCommand}"
                                IsEnabled="{Binding IsBatchInstalling, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      Fill="#FFFFFF"
                                      Data="{StaticResource IconDownload}"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Instalar Selecionadas"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Botão Marcar Todas Disponíveis -->
                        <Button Style="{StaticResource GhostIconButton}"
                                Width="Auto"
                                Height="34"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                ToolTip="Selecionar todas as plataformas disponíveis para instalação"
                                Command="{Binding SelectAllAvailableCommand}"
                                IsEnabled="{Binding IsBatchInstalling, Converter={StaticResource InverseBooleanConverter}}">
                            <TextBlock Text="Todas Disponíveis"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>

                        <!-- Botão Desmarcar -->
                        <Button Style="{StaticResource GhostIconButton}"
                                Width="Auto"
                                Height="34"
                                Padding="12,0"
                                ToolTip="Desmarcar todas as plataformas"
                                Command="{Binding ClearSelectionCommand}"
                                IsEnabled="{Binding IsBatchInstalling, Converter={StaticResource InverseBooleanConverter}}">
                            <TextBlock Text="Desmarcar"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. BARRA DE STATUS / RODAPÉ -->
        <Border Grid.Row="4"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status de Operação do Hub -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessEmeraldBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Nota de Segurança e Origem Oficial -->
                <TextBlock Grid.Column="1"
                           Text="Segurança: Downloads diretos dos repositórios oficiais com verificação de integridade e assinatura digital Authenticode."
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <!-- Indicador de Plataforma e Botão de Verificação de Atualização -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Verificar Atualizações"
                            Style="{StaticResource ModernTextButton}"
                            FontSize="11"
                            Foreground="{StaticResource AccentIndigoBrush}"
                            Margin="0,0,14,0"
                            Command="{Binding CheckForUpdatesCommand}"
                            ToolTip="Verificar se há novas versões disponíveis no GitHub Releases" />
                    <TextBlock Text=".NET 10 | Windows Desktop"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
