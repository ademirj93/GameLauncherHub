<UserControl x:Class="GameLauncherHub.UI.Views.Components.LauncherCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:GameLauncherHub.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:StateToBrushConverter x:Key="StateToBrushConverter" />
        <converters:StateToActionTextConverter x:Key="StateToActionTextConverter" />
        <converters:StateToBadgeTextConverter x:Key="StateToBadgeTextConverter" />
        <converters:StateToProgressVisibilityConverter x:Key="StateToProgressVisibilityConverter" />
        <converters:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
        <converters:ThumbnailImageConverter x:Key="ThumbnailImageConverter" />
    </UserControl.Resources>

    <Border BorderThickness="1"
            CornerRadius="8"
            Margin="0,3,0,3"
            Padding="12,8"
            ClipToBounds="True">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderHoverBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <!-- Favorito -->
                <ColumnDefinition Width="Auto" /> <!-- Seleção em lote -->
                <ColumnDefinition Width="Auto" /> <!-- Mini Ícone / Arte -->
                <ColumnDefinition Width="*" />    <!-- Nome e Detalhes -->
                <ColumnDefinition Width="Auto" /> <!-- Barra / Info de Progresso se ativo -->
                <ColumnDefinition Width="Auto" /> <!-- Badge de Status -->
                <ColumnDefinition Width="Auto" /> <!-- Botão Ação Principal -->
                <ColumnDefinition Width="Auto" /> <!-- Botão Localizar .exe -->
                <ColumnDefinition Width="Auto" /> <!-- Botão Site -->
            </Grid.ColumnDefinitions>

            <!-- 1. Botão de Favorito -->
            <Button Grid.Column="0"
                    Style="{StaticResource GhostIconButton}"
                    Width="28" Height="28"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    ToolTip="Marcar como favorito"
                    Command="{Binding ToggleFavoriteCommand}">
                <Path Width="14" Height="14" Stretch="Uniform">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IconStarOutline}" />
                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconStar}" />
                                    <Setter Property="Fill" Value="#F59E0B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Button>

            <!-- 2. CheckBox Seleção Lote -->
            <CheckBox Grid.Column="1"
                      IsChecked="{Binding IsSelected}"
                      Style="{StaticResource ModernSelectionCheckBox}"
                      Visibility="{Binding CanBeSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      ToolTip="Selecionar para instalação conjunta" />

            <!-- 3. Mini Ícone da Plataforma -->
            <Border Grid.Column="2"
                    Width="36"
                    Height="36"
                    CornerRadius="8"
                    Background="{Binding BrandColor, Converter={StaticResource HexToBrushConverter}}"
                    BorderBrush="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    ClipToBounds="True">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Arte SteamGridDB com thumbnail reduzido -->
                    <Image Source="{Binding ArtworkPath, Converter={StaticResource ThumbnailImageConverter}, ConverterParameter=48}"
                           Width="26"
                           Height="26"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding ArtworkPath, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                    <!-- Fallback Vetorial -->
                    <Path Width="18"
                          Height="18"
                          Stretch="Uniform"
                          Fill="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}"
                          Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                          Visibility="{Binding ArtworkPath, Converter={StaticResource StringNotEmptyToVisibilityConverter}, ConverterParameter=Inverse}" />
                </Grid>
            </Border>

            <!-- 4. Nome da Plataforma e Tagline / Status -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <!-- Badge de Console / Sistema Alvo -->
                    <Border Background="#1C2230"
                            BorderBrush="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="5,1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasTargetSystem, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding TargetSystem}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}" />
                    </Border>
                    <TextBlock Text="{Binding StatusMessage, StringFormat='• {0}', TargetNullValue=''}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{Binding Tagline}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- 5. Progresso (quando em download/instalação) -->
            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        Visibility="{Binding State, Converter={StaticResource StateToProgressVisibilityConverter}}">
                <ProgressBar Width="90" Height="6"
                             Value="{Binding OperationProgress}"
                             Maximum="100"
                             Background="#252A38"
                             Foreground="{StaticResource AccentIndigoBrush}"
                             BorderThickness="0"
                             VerticalAlignment="Center" />
                <TextBlock Text="{Binding OperationProgress, StringFormat=' {0:F0}%'}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentIndigoBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0" />
            </StackPanel>

            <!-- 6. Badge de Status -->
            <Border Grid.Column="5"
                    CornerRadius="6"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Background="#141720"
                    BorderBrush="{Binding State, Converter={StaticResource StateToBrushConverter}}"
                    BorderThickness="1">
                <TextBlock Text="{Binding State, Converter={StaticResource StateToBadgeTextConverter}}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{Binding State, Converter={StaticResource StateToBrushConverter}}" />
            </Border>

            <!-- 7. Botão Ação Principal -->
            <Button Grid.Column="6"
                    Style="{StaticResource ModernActionButton}"
                    Height="32"
                    MinWidth="100"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    Background="{Binding State, Converter={StaticResource StateToBrushConverter}}"
                    BorderThickness="0"
                    Command="{Binding ExecuteActionCommand}">
                <TextBlock Text="{Binding State, Converter={StaticResource StateToActionTextConverter}}"
                           FontWeight="SemiBold"
                           FontSize="11" />
            </Button>

            <!-- 8. Botão Localizar Executável -->
            <Button Grid.Column="7"
                    Style="{StaticResource GhostIconButton}"
                    Width="32" Height="32"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="Localizar executável (.exe) no computador"
                    Command="{Binding LocateExecutableCommand}">
                <Path Width="13"
                      Height="13"
                      Stretch="Uniform"
                      Fill="{StaticResource TextSecondaryBrush}"
                      Data="{StaticResource IconFolderOpen}" />
            </Button>

            <!-- 9. Botão Site Oficial -->
            <Button Grid.Column="8"
                    Style="{StaticResource GhostIconButton}"
                    Width="32" Height="32"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="Abrir página oficial autorizada"
                    Command="{Binding OpenWebsiteCommand}">
                <Path Width="13"
                      Height="13"
                      Stretch="Uniform"
                      Fill="{StaticResource TextSecondaryBrush}"
                      Data="{StaticResource IconExternalLink}" />
            </Button>
        </Grid>
    </Border>
</UserControl>

