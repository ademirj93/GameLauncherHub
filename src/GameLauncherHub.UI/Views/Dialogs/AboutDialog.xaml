<Window x:Class="GameLauncherHub.UI.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sobre o GameLauncher Hub"
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource MainFontFamily}"
        Icon="/Resources/icon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="4"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />  <!-- Barra de Título -->
                <RowDefinition Height="*" />   <!-- Conteúdo -->
                <RowDefinition Height="56" />  <!-- Rodapé -->
            </Grid.RowDefinitions>

            <!-- 1. Barra de Título -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="14"
                              Height="14"
                              Stretch="Uniform"
                              Fill="{StaticResource AccentIndigoBrush}"
                              Data="{StaticResource IconInfo}"
                              Margin="0,0,10,0" />
                        <TextBlock Text="Sobre o Aplicativo"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FFFFFF" />
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource WindowCloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            ToolTip="Fechar">
                        <Path Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Fill="#FFFFFF"
                              Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Conteúdo Central -->
            <ScrollViewer Grid.Row="1" Padding="28,20">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Logo do Projeto -->
                    <Border CornerRadius="12"
                            Background="#12141C"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            Padding="8"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              Opacity="0.45"
                                              ShadowDepth="4"
                                              Direction="270"
                                              Color="#000000" />
                        </Border.Effect>
                        <Image Source="/Resources/logo.bmp"
                               MaxHeight="120"
                               MaxWidth="360"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- Nome e Release Badge -->
                    <TextBlock Text="GameLauncher Hub"
                               FontWeight="Black"
                               FontSize="20"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,18">
                        <Border Background="#1C202C"
                                BorderBrush="{StaticResource SuccessEmeraldBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,2"
                                Margin="0,0,8,0">
                            <TextBlock x:Name="VersionTextBlock"
                                       Text="Release 0.11.10b2"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessEmeraldBrush}" />
                        </Border>

                        <Border Background="#1C202C"
                                BorderBrush="{StaticResource AccentIndigoBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,2">
                            <TextBlock Text="04/11/2026"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentIndigoBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Tabela de Metadados -->
                    <Border Background="{StaticResource SurfaceBackgroundBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Width="440"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Desenvolvedor:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Ademir Junior" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,3" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Licença:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="GNU General Public License v3.0 (GPLv3)" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Plataforma:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="C# 14 / .NET 10 (LTS) Windows Desktop" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Arquitetura:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Clean Architecture &amp; MVVM WPF" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3" />
                        </Grid>
                    </Border>

                    <!-- Descrição -->
                    <TextBlock Text="Centralizador de plataformas de jogos para Windows com detecção multi-estratégia, downloads oficiais com verificação de integridade PE e assinaturas Authenticode."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Width="440"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               LineHeight="16" />

                    <!-- Seção de Verificação de Atualizações no GitHub -->
                    <Border Background="{StaticResource SurfaceBackgroundBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Width="440"
                            Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Atualizações de Software (GitHub)"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="#FFFFFF" />
                                <TextBlock x:Name="UpdateStatusTextBlock"
                                           Text="Clique para verificar se há novas versões no GitHub."
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="CheckUpdatesButton"
                                        Content="Verificar"
                                        Style="{StaticResource ModernActionButton}"
                                        Background="{StaticResource AccentIndigoBrush}"
                                        Height="28"
                                        Padding="12,0"
                                        Click="CheckUpdatesButton_Click" />

                                <Button x:Name="OpenUpdateButton"
                                        Content="Atualizar Agora"
                                        Style="{StaticResource ModernActionButton}"
                                        Background="{StaticResource SuccessEmeraldBrush}"
                                        Height="28"
                                        Padding="12,0"
                                        Margin="6,0,0,0"
                                        Visibility="Collapsed"
                                        Click="OpenUpdateButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Rodapé com Botão Fechar -->
            <Border Grid.Row="2"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Button Content="Fechar"
                        Style="{StaticResource ModernActionButton}"
                        Background="{StaticResource AccentIndigoBrush}"
                        Height="34"
                        Width="100"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click" />
            </Border>
        </Grid>
    </Border>
</Window>

