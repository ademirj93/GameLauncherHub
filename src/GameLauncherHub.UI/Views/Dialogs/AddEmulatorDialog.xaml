<Window x:Class="GameLauncherHub.UI.Views.Dialogs.AddEmulatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Adicionar Emulador — GameLauncher Hub"
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource MainFontFamily}"
        Icon="/Resources/icon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="4"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />  <!-- Barra de Título -->
                <RowDefinition Height="*" />   <!-- Formulário -->
                <RowDefinition Height="56" />  <!-- Rodapé com Ações -->
            </Grid.RowDefinitions>

            <!-- 1. Barra de Título Customizada -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource AccentIndigoBrush}" Margin="0,0,10,0">
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" Data="{StaticResource IconGamepad}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Adicionar Emulador ao Hub"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FFFFFF" />
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource WindowCloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CancelButton_Click"
                            ToolTip="Fechar">
                        <Path Width="10" Height="10" Stretch="Uniform" Fill="#FFFFFF" Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Formulário de Cadastro -->
            <ScrollViewer Grid.Row="1" Padding="24,18" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Introdução Informativa -->
                    <Border Background="#141722"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource AccentIndigoBrush}" Data="{StaticResource IconInfo}" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="Cadastre emuladores instalados ou portáteis. Eles serão integrados à biblioteca com detecção rápida e execução com 1 clique."
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       MaxWidth="420"
                                       LineHeight="16" />
                        </StackPanel>
                    </Border>

                    <!-- Nome do Emulador -->
                    <TextBlock Text="Nome do Emulador *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="NameTextBox"
                             Style="{StaticResource ModernSearchBox}"
                             Padding="12,8"
                             Height="36"
                             Margin="0,0,0,14" />

                    <!-- Console / Sistema Emulado -->
                    <TextBlock Text="Console / Sistema Emulado *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox x:Name="SystemComboBox"
                              Height="36"
                              Background="{StaticResource SurfaceBackgroundBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource SurfaceBorderBrush}"
                              BorderThickness="1"
                              IsEditable="True"
                              Margin="0,0,0,14"
                              FontSize="12">
                        <ComboBoxItem Content="Nintendo Wii U" />
                        <ComboBoxItem Content="Nintendo GameCube / Wii" />
                        <ComboBoxItem Content="Nintendo Switch" />
                        <ComboBoxItem Content="Nintendo 3DS" />
                        <ComboBoxItem Content="Nintendo 64" />
                        <ComboBoxItem Content="Super Nintendo (SNES)" />
                        <ComboBoxItem Content="Game Boy / GBC / GBA" />
                        <ComboBoxItem Content="Sony PlayStation 1 (PSone)" />
                        <ComboBoxItem Content="Sony PlayStation 2" />
                        <ComboBoxItem Content="Sony PlayStation 3" />
                        <ComboBoxItem Content="Sony PlayStation Portable (PSP)" />
                        <ComboBoxItem Content="Sony PlayStation Vita" />
                        <ComboBoxItem Content="Microsoft Xbox Original" />
                        <ComboBoxItem Content="Microsoft Xbox 360" />
                        <ComboBoxItem Content="Sega Dreamcast" />
                        <ComboBoxItem Content="Sega Saturn" />
                        <ComboBoxItem Content="Sega Mega Drive / Genesis" />
                        <ComboBoxItem Content="Multi-sistema (Arcade / Retro)" />
                        <ComboBoxItem Content="Frontend Multi-emulador PC" />
                    </ComboBox>

                    <!-- Caminho do Executável (.exe) -->
                    <TextBlock Text="Caminho do Executável (.exe) *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExecutablePathTextBox"
                                 Style="{StaticResource ModernSearchBox}"
                                 Padding="12,8"
                                 Height="36" />
                        <Button Grid.Column="1"
                                Content="Procurar..."
                                Style="{StaticResource ModernActionButton}"
                                Background="#252A38"
                                Height="36"
                                Padding="14,0"
                                Margin="8,0,0,0"
                                Click="BrowseButton_Click" />
                    </Grid>

                    <!-- Argumentos de Linha de Comando -->
                    <TextBlock Text="Argumentos de Linha de Comando (opcional)"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="ArgumentsTextBox"
                             Style="{StaticResource ModernSearchBox}"
                             Padding="12,8"
                             Height="36"
                             Margin="0,0,0,14" />

                    <!-- Site Oficial / Link -->
                    <TextBlock Text="Site Oficial ou Repositório GitHub (opcional)"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="WebsiteTextBox"
                             Style="{StaticResource ModernSearchBox}"
                             Padding="12,8"
                             Height="36"
                             Margin="0,0,0,14" />

                    <!-- Mensagem de Validação / Erro -->
                    <TextBlock x:Name="ErrorMessageTextBlock"
                               Foreground="#EF4444"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Rodapé com Ações -->
            <Border Grid.Row="2"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancelar"
                            Style="{StaticResource ModernTextButton}"
                            Height="34"
                            Padding="16,0"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click" />

                    <Button Content="Salvar e Adicionar"
                            Style="{StaticResource ModernActionButton}"
                            Background="{StaticResource AccentIndigoBrush}"
                            Height="36"
                            Padding="18,0"
                            FontWeight="Bold"
                            Click="SaveButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
