<Window x:Class="GameLauncherHub.UI.Views.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:GameLauncherHub.UI.ViewModels"
        xmlns:converters="clr-namespace:GameLauncherHub.UI.Converters"
        mc:Ignorable="d"
        Title="Configurações — GameLauncher Hub"
        Height="680" Width="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource MainFontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="4"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />  <!-- Barra de Título -->
                <RowDefinition Height="*" />   <!-- Conteúdo com Scroll -->
                <RowDefinition Height="56" />  <!-- Barra de Botões -->
            </Grid.RowDefinitions>

            <!-- 1. Barra de Título do Diálogo -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="14"
                              Height="14"
                              Stretch="Uniform"
                              Fill="{StaticResource AccentIndigoBrush}"
                              Data="{StaticResource IconSettings}"
                              Margin="0,0,10,0" />
                        <TextBlock Text="Configurações do GameLauncher Hub"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FFFFFF" />
                    </StackPanel>

                    <!-- Fechar Janela -->
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource WindowCloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            ToolTip="Fechar">
                        <Path Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Fill="#FFFFFF"
                              Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Conteúdo Principal -->
            <ScrollViewer Grid.Row="1" Padding="24,18">
                <StackPanel>

                    <!-- SEÇÃO 1: STEAMGRIDDB — ARTES E ÍCONES -->
                    <TextBlock Text="STEAMGRIDDB — ARTES E ÍCONES DOS LAUNCHERS"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{StaticResource AccentIndigoBrush}"
                               Margin="0,0,0,10" />

                    <Border Background="{StaticResource SurfaceBackgroundBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Chave da API oficial do SteamGridDB (API Key):"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="Obtenha sua chave gratuita em https://www.steamgriddb.com/profile/preferences/api para carregar artes oficiais e ícones da comunidade nos cards."
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <TextBox Text="{Binding SteamGridDbApiKey, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#141720"
                                         Foreground="#FFFFFF"
                                         BorderBrush="{StaticResource SurfaceBorderBrush}"
                                         BorderThickness="1"
                                         Padding="10,6"
                                         FontSize="12"
                                         Height="34"
                                         VerticalContentAlignment="Center" />
                            </Grid>

                            <TextBlock Text="* Sua chave de API é criptografada com DPAPI (Data Protection API) do Windows antes de ser salva em disco."
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontStyle="Italic"
                                       Margin="0,0,0,12" />

                            <!-- Botões de Ação do SteamGridDB -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Testar Conexão"
                                        Style="{StaticResource ModernActionButton}"
                                        Background="{StaticResource AccentIndigoBrush}"
                                        Height="32"
                                        Padding="14,0"
                                        Margin="0,0,8,6"
                                        Command="{Binding TestSteamGridDbApiKeyCommand}"
                                        IsEnabled="{Binding IsTestingApiKey, Converter={StaticResource InverseBooleanConverter}}" />

                                <Button Content="Atualizar Artes dos Launchers"
                                        Style="{StaticResource GhostIconButton}"
                                        Width="Auto"
                                        Height="32"
                                        Padding="12,0"
                                        Margin="0,0,8,6"
                                        Command="{Binding RefreshArtworkCommand}" />

                                <Button Content="Limpar Cache Local"
                                        Style="{StaticResource GhostIconButton}"
                                        Width="Auto"
                                        Height="32"
                                        Padding="12,0"
                                        Margin="0,0,8,6"
                                        ToolTip="Exclui o cache local em %LOCALAPPDATA%/GameLauncherHub/Cache/SteamGridDB/"
                                        Command="{Binding ClearArtworkCacheCommand}" />
                            </WrapPanel>

                            <!-- Status do Teste / Feedback -->
                            <TextBlock Text="{Binding ApiTestStatus}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ApiTestStatus, Converter={StaticResource StringNotEmptyToVisibilityConverter}, FallbackValue=Collapsed}" />
                        </StackPanel>
                    </Border>


                    <!-- SEÇÃO 2: BANDEJA DO SISTEMA (SYSTEM TRAY) -->
                    <TextBlock Text="BANDEJA DO SISTEMA (SYSTEM TRAY)"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{StaticResource AccentIndigoBrush}"
                               Margin="0,0,0,10" />

                    <Border Background="{StaticResource SurfaceBackgroundBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox Content="Habilitar ícone na bandeja do sistema (System Tray)"
                                      IsChecked="{Binding EnableSystemTray}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Cursor="Hand" />

                            <CheckBox Content="Manter em segundo plano na bandeja ao fechar a janela (Close to Tray)"
                                      IsChecked="{Binding CloseToTray}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,12,0,0"
                                      Cursor="Hand" />

                            <CheckBox Content="Ocultar na bandeja ao minimizar a janela"
                                      IsChecked="{Binding MinimizeToTray}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,12,0,0"
                                      Cursor="Hand" />

                            <TextBlock Text="Lançadores exibidos no menu da bandeja:"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,16,0,8" />

                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Todos os launchers instalados"
                                             IsChecked="{Binding IsTrayAllInstalled, Mode=TwoWay}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             GroupName="TrayDisplayGroup"
                                             Cursor="Hand"
                                             Margin="0,0,16,0" />

                                <RadioButton Content="Apenas os favoritos instalados"
                                             IsChecked="{Binding IsTrayFavoritesOnly, Mode=TwoWay}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             GroupName="TrayDisplayGroup"
                                             Cursor="Hand" />
                            </StackPanel>
                        </StackPanel>
                    </Border>


                    <!-- SEÇÃO 3: VISUALIZAÇÃO PADRÃO -->
                    <TextBlock Text="VISUALIZAÇÃO PADRÃO"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{StaticResource AccentIndigoBrush}"
                               Margin="0,0,0,10" />

                    <Border Background="{StaticResource SurfaceBackgroundBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Layout padrão de exibição dos launchers:"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Cards Grandes (Visual moderno com cores de marca)"
                                             IsChecked="{Binding IsViewCards, Mode=TwoWay}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             GroupName="DefaultViewModeGroup"
                                             Cursor="Hand"
                                             Margin="0,0,20,0" />

                                <RadioButton Content="Visualização Compacta (Linhas horizontais otimizadas)"
                                             IsChecked="{Binding IsViewCompact, Mode=TwoWay}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             GroupName="DefaultViewModeGroup"
                                             Cursor="Hand" />
                            </StackPanel>
                        </StackPanel>
                    </Border>


                    <!-- SEÇÃO 4: ARMAZENAMENTO E DOWNLOADS -->
                    <TextBlock Text="ARMAZENAMENTO &amp; DOWNLOADS"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{StaticResource AccentIndigoBrush}"
                               Margin="0,0,0,10" />

                    <Border Background="{StaticResource SurfaceBackgroundBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Pasta temporária de downloads dos instaladores:"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#141720"
                                         Foreground="#FFFFFF"
                                         BorderBrush="{StaticResource SurfaceBorderBrush}"
                                         BorderThickness="1"
                                         Padding="10,6"
                                         FontSize="12"
                                         Height="34"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="Procurar..."
                                        Style="{StaticResource ModernActionButton}"
                                        Background="{StaticResource AccentIndigoBrush}"
                                        Margin="8,0,0,0"
                                        Height="34"
                                        Command="{Binding BrowseDownloadDirectoryCommand}" />
                            </Grid>

                            <CheckBox Content="Excluir instaladores temporários após conclusão bem-sucedida"
                                      IsChecked="{Binding AutoCleanupInstallers}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,14,0,0"
                                      Cursor="Hand" />
                        </StackPanel>
                    </Border>


                    <!-- SEÇÃO 5: SISTEMA & INICIALIZAÇÃO -->
                    <TextBlock Text="SISTEMA &amp; INICIALIZAÇÃO"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{StaticResource AccentIndigoBrush}"
                               Margin="0,0,0,10" />

                    <Border Background="{StaticResource SurfaceBackgroundBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox Content="Inicializar GameLauncher Hub automaticamente com o Windows"
                                      IsChecked="{Binding LaunchOnStartup}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Cursor="Hand" />

                            <CheckBox Content="Verificar automaticamente novos launchers instalados ao iniciar"
                                      IsChecked="{Binding AutoCheckInstallationsOnStartup}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,12,0,0"
                                      Cursor="Hand" />

                            <CheckBox Content="Exibir notificações na área de trabalho ao concluir downloads"
                                      IsChecked="{Binding ShowNotifications}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,12,0,0"
                                      Cursor="Hand" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 3. Barra Inferior de Ações -->
            <Border Grid.Row="2"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Button Content="Restaurar Padrões"
                            Style="{StaticResource GhostIconButton}"
                            Width="140"
                            Height="34"
                            HorizontalAlignment="Left"
                            Command="{Binding ResetDefaultsCommand}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Style="{StaticResource GhostIconButton}"
                                Width="90"
                                Height="34"
                                Margin="0,0,10,0"
                                Command="{Binding CancelCommand}" />

                        <Button Content="Salvar Alterações"
                                Style="{StaticResource ModernActionButton}"
                                Background="{StaticResource SuccessEmeraldBrush}"
                                Height="34"
                                Width="140"
                                Command="{Binding SaveSettingsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
