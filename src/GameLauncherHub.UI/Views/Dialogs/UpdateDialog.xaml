<Window x:Class="GameLauncherHub.UI.Views.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:GameLauncherHub.UI.Converters"
        mc:Ignorable="d"
        Title="Atualização Disponível — GameLauncher Hub"
        Height="620" Width="560"
        MinHeight="500" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource MainFontFamily}"
        Icon="/Resources/icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="4"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />  <!-- 1. Barra de Título -->
                <RowDefinition Height="*" />   <!-- 2. Conteúdo Central -->
                <RowDefinition Height="Auto" /><!-- 3. Seção de Progresso de Download (se ativo) -->
                <RowDefinition Height="60" />  <!-- 4. Rodapé com Botões de Ação -->
            </Grid.RowDefinitions>

            <!-- 1. BARRA DE TÍTULO CUSTOMIZADA -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource SuccessEmeraldBrush}" Margin="0,0,10,0">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="#FFFFFF" Data="{StaticResource IconDownload}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Atualização de Versão Disponível"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FFFFFF" />
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource WindowCloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding DismissCommand}"
                            ToolTip="Fechar">
                        <Path Width="10" Height="10" Stretch="Uniform" Fill="#FFFFFF" Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 2. CONTEÚDO PRINCIPAL -->
            <ScrollViewer Grid.Row="1" Padding="24,18" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header da Release com Badges de Versão -->
                    <Border Background="{StaticResource SurfaceBackgroundBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding UpdateInfo.ReleaseName}"
                                           FontWeight="Black"
                                           FontSize="16"
                                           Foreground="#FFFFFF"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="{Binding UpdateInfo.PublishedAt, StringFormat='Publicado em {0:dd/MM/yyyy às HH:mm}'}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,4,0,10" />

                                <!-- Comparativo de Versão -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1C202C"
                                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="{Binding UpdateInfo.FormattedCurrentVersion, StringFormat='Instalada: {0}'}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>

                                    <TextBlock Text="➔" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                    <Border Background="#122A1E"
                                            BorderBrush="{StaticResource SuccessEmeraldBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,3">
                                        <TextBlock Text="{Binding UpdateInfo.TagName, StringFormat='Nova: {0}'}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessEmeraldBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Badge de Tamanho -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                                <Border Background="#1C202C"
                                        BorderBrush="{StaticResource AccentIndigoBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3">
                                    <TextBlock Text="{Binding UpdateInfo.FormattedSize}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentIndigoBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Título Notas da Versão -->
                    <TextBlock Text="NOTAS DA VERSÃO (CHANGELOG)"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{StaticResource AccentIndigoBrush}"
                               Margin="0,0,0,8" />

                    <!-- Caixa de Notas de Atualização -->
                    <Border Background="#12141C"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            MinHeight="140"
                            MaxHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding UpdateInfo.ReleaseNotes}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <!-- Mensagem de Erro (se houver) -->
                    <Border Background="#331515"
                            BorderBrush="#EF4444"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,12,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FCA5A5"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. SEÇÃO DE DOWNLOAD & PROGRESSO -->
            <Border Grid.Row="2"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF" />
                        <TextBlock Text="{Binding DownloadSpeedText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ProgressBar Height="8"
                                 Value="{Binding DownloadPercentage}"
                                 Maximum="100"
                                 Foreground="{StaticResource SuccessEmeraldBrush}"
                                 Background="#1A1D27"
                                 BorderThickness="0"
                                 Margin="0,0,0,6" />

                    <Grid>
                        <TextBlock Text="{Binding DownloadProgressText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <Button Content="Cancelar Download"
                                Style="{StaticResource ModernTextButton}"
                                HorizontalAlignment="Right"
                                FontSize="11"
                                Foreground="#EF4444"
                                Command="{Binding CancelDownloadCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. RODAPÉ COM AÇÕES -->
            <Border Grid.Row="3"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostIconButton}"
                            Height="32"
                            Padding="10,0"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenGitHubReleaseCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}" Data="{StaticResource IconInfo}" Margin="0,0,6,0" />
                            <TextBlock Text="Página da Release" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Mais Tarde"
                                Style="{StaticResource ModernTextButton}"
                                Height="34"
                                Width="90"
                                Margin="0,0,10,0"
                                Command="{Binding DismissCommand}"
                                IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}" />

                        <Button Content="Atualizar Agora"
                                Style="{StaticResource ModernActionButton}"
                                Background="{StaticResource SuccessEmeraldBrush}"
                                Height="36"
                                Padding="16,0"
                                FontWeight="Bold"
                                Command="{Binding DownloadAndInstallCommand}"
                                IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
