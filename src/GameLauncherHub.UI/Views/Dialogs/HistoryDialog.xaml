<Window x:Class="GameLauncherHub.UI.Views.Dialogs.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:GameLauncherHub.UI.ViewModels"
        mc:Ignorable="d"
        Title="Histórico de Auditoria — GameLauncher Hub"
        Height="600" Width="840"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource MainFontFamily}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="4"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />  <!-- Barra de Título -->
                <RowDefinition Height="Auto" /> <!-- Filtros por Operação -->
                <RowDefinition Height="*" />   <!-- Tabela/Lista de Logs -->
                <RowDefinition Height="50" />  <!-- Rodapé -->
            </Grid.RowDefinitions>

            <!-- 1. Barra de Título -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="14"
                              Height="14"
                              Stretch="Uniform"
                              Fill="{StaticResource AccentIndigoBrush}"
                              Data="{StaticResource IconHistory}"
                              Margin="0,0,10,0" />
                        <TextBlock Text="Histórico &amp; Auditoria de Operações"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FFFFFF" />
                    </StackPanel>

                    <!-- Fechar Janela -->
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource WindowCloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            ToolTip="Fechar">
                        <Path Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Fill="#FFFFFF"
                              Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Filtros por Tipo de Operação -->
            <Border Grid.Row="1"
                    Background="#10121A"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Todos"
                                 Style="{StaticResource FilterPillButton}"
                                 IsChecked="True"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="Todos" />

                    <RadioButton Content="Downloads"
                                 Style="{StaticResource FilterPillButton}"
                                 Margin="6,0,0,0"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="Download" />

                    <RadioButton Content="Assinatura"
                                 Style="{StaticResource FilterPillButton}"
                                 Margin="6,0,0,0"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="SignatureVerification" />

                    <RadioButton Content="Instalações"
                                 Style="{StaticResource FilterPillButton}"
                                 Margin="6,0,0,0"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="Installation" />

                    <RadioButton Content="Execuções"
                                 Style="{StaticResource FilterPillButton}"
                                 Margin="6,0,0,0"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="Execution" />
                </StackPanel>
            </Border>

            <!-- 3. Lista de Registros -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredLogs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBackgroundBrush}"
                                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status (Ícone de Sucesso ou Erro) -->
                                    <Path Grid.Column="0"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{StaticResource SuccessEmeraldBrush}" />
                                                <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource DangerRoseBrush}" />
                                                        <Setter Property="Data" Value="{StaticResource IconClose}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>

                                    <!-- Plataforma -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LauncherName}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center" />

                                    <!-- Tipo de Operação (Badge) -->
                                    <Border Grid.Column="2"
                                            Background="#141720"
                                            BorderBrush="{StaticResource AccentIndigoBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OperationType}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentIndigoBrush}" />
                                    </Border>

                                    <!-- Mensagem / Detalhes -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Message}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="8,0" />

                                    <!-- Data e Hora -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 4. Barra Inferior -->
            <Border Grid.Row="3"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Button Content="Limpar Todo o Histórico"
                            Style="{StaticResource GhostIconButton}"
                            Width="170"
                            Height="32"
                            HorizontalAlignment="Left"
                            Command="{Binding ClearHistoryCommand}" />

                    <Button Content="Fechar"
                            Style="{StaticResource ModernActionButton}"
                            Background="{StaticResource AccentIndigoBrush}"
                            Width="90"
                            Height="32"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

