[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
publish/
[Aa]rtifacts/
TestResults/

# Arquivos gerados durante a compilação
*.pdb
*.i[di]b
*.ilk
*.aps
*.pch
*.exp
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# ---------------------------------------------------------
# Pacotes e Ferramentas NuGet
# ---------------------------------------------------------
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# ---------------------------------------------------------
# Visual Studio / ReSharper / JetBrains Rider
# ---------------------------------------------------------
.vs/
.idea/
*.DotSettings.user
_ReSharper*/
*.ReSharper
*.vspscc
*.vssscc

# ---------------------------------------------------------
# Visual Studio Code
# ---------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ---------------------------------------------------------
# Testes & Cobertura de Código
# ---------------------------------------------------------
coverage/
*.coverage
*.coveragexml

# ---------------------------------------------------------
# Crash Dumps & Diagnósticos
# ---------------------------------------------------------
*.dmp
*.dump
*.crashdump
*.stackdump

# ---------------------------------------------------------
# Inno Setup & Instaladores
# ---------------------------------------------------------
installer/Output/
*.iss.bak

# ---------------------------------------------------------
# Chaves, Certificados & Arquivos de Configuração Local
# ---------------------------------------------------------
*.pfx
*.cer
*.p12
*.snk
appsettings*.local.json
*.local.json
secrets.json

# ---------------------------------------------------------
# Sistema Operacional Windows
# ---------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------
# Ferramentas de IA e Ambientes Locais
# ---------------------------------------------------------
.gemini/
.claude/
.cursor/

